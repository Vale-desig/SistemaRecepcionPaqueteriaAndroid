<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4A174"
    tools:context=".EntregarPaqueteActivity">

    <TextView
        android:id="@+id/titulo_entregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entregar paquete"
        android:textColor="#121212"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <EditText
        android:id="@+id/campo_residente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nombre del residente"
        android:inputType="textPersonName"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/titulo_entregar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <EditText
        android:id="@+id/campo_apartamento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Número de apartamento"
        android:inputType="text"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/campo_residente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />
    
    <EditText
        android:id="@+id/campo_guia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Número de guía del paquete"
        android:inputType="text"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/campo_apartamento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <EditText
        android:id="@+id/campo_recibe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nombre de quien recibe"
        android:inputType="textPersonName"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/campo_guia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <Button
        android:id="@+id/btn_confirmar_entrega"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmar entrega"
        android:textColor="#FFFFFF"
        android:backgroundTint="#121212"
        app:layout_constraintTop_toBottomOf="@id/campo_recibe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <Button
        android:id="@+id/btn_volver_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver al menú"
        android:textColor="#FFFFFF"
        android:backgroundTint="#BF4D0F"
        app:layout_constraintTop_toBottomOf="@id/btn_confirmar_entrega"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp" />

</androidx.constraintlayout.widget.ConstraintLayout>